# CUBE Prep Manager - Environment Configuration Template
# Copy this file to .env for local overrides, or set in production host (Render/Fly.io/Railway)

# Environment & Server
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS (Comma-separated for Next.js on Vercel)
CORS_ORIGINS=["http://localhost:3000","https://cube-prep-manager.vercel.app","https://*.vercel.app"]

# Storage Provider ('local' for offline/dev, 'supabase' for production S3-compatible cloud storage)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=data/uploads

# Database Provider ('local' for SQLite/JSON, 'supabase' for cloud PostgreSQL)
DATABASE_BACKEND=local

# Supabase Credentials (Required if STORAGE_BACKEND=supabase or DATABASE_BACKEND=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=prep-evidence-images

# Security & Multi-Tenancy (Rule 1)
DEFAULT_ORG_ID=org_demo_alpha
REQUIRE_AUTH=false
SERVER_API_KEY=your-secure-internal-api-key

# Inference & Detection
ONNX_MODEL_PATH=models/best_detector.onnx
INFERENCE_IMGSZ=640
BLUR_THRESHOLD=25.0
